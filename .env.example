# ---- CNM Essentials environment variables (set in Netlify → Site configuration → Environment variables) ----
# Never commit real values. Only variables prefixed GA_ are exposed to the browser (build-time); everything else stays server-side.

# Launch gate: production is indexed by search engines ONLY when this is "true" (after CNM final approval).
CNM_LAUNCH_APPROVED=false
# Canonical URL override (defaults to Netlify's URL). Set to https://cnmessentials.com at launch.
SITE_URL=

# Sessions — long random string (e.g. `openssl rand -base64 48`). If unset, one is generated and stored server-side.
SESSION_SECRET=

# Payments — Paystack adapter (netlify/lib/payments/). Without a key, staging uses the payment simulator.
# Use sk_test_… on staging and sk_live_… only on production. Dashboard → Settings → API Keys & Webhooks.
PAYSTACK_SECRET_KEY=
# Optional: limit payment methods (default: card,bank,ussd,bank_transfer,qr,mobile_money)
PAYSTACK_CHANNELS=
# Optional: also require webhooks to come from Paystack's published IPs (the signature is always verified)
PAYSTACK_ENFORCE_IPS=false
# Webhook URL to register in Paystack: https://cnmshop.netlify.app/api/payments/paystack-webhook

# Email — Resend (https://resend.com): sign-in codes, order confirmations, order updates, password resets.
# Without a key, emails are logged and staging shows the sign-in code on screen.
RESEND_API_KEY=
# Sender. Until cnmessentials.com is verified in Resend (Domains → Add domain), leave empty to use Resend's test
# sender onboarding@resend.dev, which only delivers to the Resend account owner's inbox.
EMAIL_FROM="CNM Essentials <hello@cnmessentials.com>"
EMAIL_REPLY_TO=cnmessentials@cnm-group.net
CNM_NOTIFY_EMAIL=           # receives Fragrance as a Service enquiries
CNM_LOGO_URL=               # absolute URL of the original logo for emails

# Database — Supabase (orders, customers, enquiries, subscribers, stock, content).
# 1) Run supabase/migrations/20260927000000_cnm_store.sql once in the Supabase SQL editor.
# 2) Set these two. If they are missing, the site falls back to Netlify Blobs.
SUPABASE_URL=https://mjyesgbedkmtlrxdzihr.supabase.co
# The SECRET key (Project Settings → API Keys → Secret key, "sb_secret_…"), server-side only. Never the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Admin — JSON array; hash passwords with: node scripts/hash-password.mjs 'the-password'
# Roles: owner | manager | fulfilment | editor
ADMIN_USERS=[{"email":"owner@cnmessentials.com","name":"Owner","role":"owner","passwordHash":"scrypt$..."}]
# Staging-only bootstrap owner (login: staging@cnmessentials.com). Ignored in production. Remove before launch.
ADMIN_STAGING_PASSWORD=

# Admin "Publish site" button — Netlify build hook URL
NETLIFY_BUILD_HOOK_URL=

# Analytics — Google Analytics 4 measurement ID (loaded only after cookie consent)
GA_MEASUREMENT_ID=
