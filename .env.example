# ---- CNM Essentials environment variables (set in Netlify → Site configuration → Environment variables) ----
# Never commit real values. Only variables prefixed GA_ are exposed to the browser (build-time); everything else stays server-side.

# Launch gate: production is indexed by search engines ONLY when this is "true" (after CNM final approval).
CNM_LAUNCH_APPROVED=false
# Canonical URL override (defaults to Netlify's URL). Set to https://cnmessentials.com at launch.
SITE_URL=

# Sessions — long random string (e.g. `openssl rand -base64 48`). If unset, one is generated and stored server-side.
SESSION_SECRET=

# Payments — Paystack (NEEDS CNM APPROVAL of provider). Without a key, staging uses the payment simulator.
PAYSTACK_SECRET_KEY=
# Webhook URL to register in Paystack: https://<site>/api/payments/paystack-webhook

# Email — Resend (https://resend.com). Without a key, emails are logged and staging shows dev links/codes.
RESEND_API_KEY=
EMAIL_FROM="CNM Essentials <orders@cnmessentials.com>"
CNM_NOTIFY_EMAIL=           # receives Fragrance as a Service enquiries
CNM_LOGO_URL=               # absolute URL of the original logo for emails

# Admin — JSON array; hash passwords with: node scripts/hash-password.mjs 'the-password'
# Roles: owner | manager | fulfilment | editor
ADMIN_USERS=[{"email":"owner@cnmessentials.com","name":"Owner","role":"owner","passwordHash":"scrypt$..."}]
# Staging-only bootstrap owner (login: staging@cnmessentials.com). Ignored in production. Remove before launch.
ADMIN_STAGING_PASSWORD=

# Admin "Publish site" button — Netlify build hook URL
NETLIFY_BUILD_HOOK_URL=

# Analytics — Google Analytics 4 measurement ID (loaded only after cookie consent)
GA_MEASUREMENT_ID=
