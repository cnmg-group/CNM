{
  "name": "cnm-essentials",
  "private": true,
  "version": "0.1.0",
  "description": "CNM Essentials \u2014 editorial brand site, luxury e-commerce, admin and APIs (Netlify).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "serve": "node scripts/dev-server.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@netlify/blobs": "^11.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14"
  }
}
