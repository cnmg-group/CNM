{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://cnmgg.netlify.app"
      },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://cnmgg.netlify.app"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://cnmessentials.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "NEEDS_CNM_APPROVAL@example.com",
        "ascAppId": "NEEDS_CNM_APPROVAL",
        "appleTeamId": "NEEDS_CNM_APPROVAL"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
